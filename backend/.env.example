# MongoDB connection string
# Local: mongodb://localhost:27017/disease-predictor
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/disease-predictor
MONGO_URI=mongodb://localhost:27017/disease-predictor

# Google Places API key (https://console.cloud.google.com)
GOOGLE_API_KEY=your_google_api_key_here

# ML service URL
# Local: http://127.0.0.1:8000
# Production: https://your-ml-service.onrender.com
ML_SERVICE_URL=http://127.0.0.1:8000

# Server port (Render uses PORT env var automatically)
PORT=5000

# CORS allowed origins (comma-separated)
# Local: http://localhost:5173,http://localhost:3000
# Production: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
